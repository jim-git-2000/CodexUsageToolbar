#!/usr/bin/env python3
import argparse
import glob
import json
import os
import select
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import time
from datetime import datetime
from decimal import Decimal


SCHEMA_VERSION = "1.1"
DEFAULT_WINDOWS = ("today", "1d", "7d", "14d", "30d")
CODEX_SESSIONS_GLOB = "~/.codex/sessions/**/*.jsonl"
FIVE_HOUR_MINUTES = 300
WEEKLY_MINUTES = 10080
RESET_CREDITS_CACHE = "~/.cache/codex-usage-toolbar/reset-credits.json"
RESET_CREDITS_TTL_SECONDS = 3600


def iso_from_epoch(ts):
    if ts is None:
        return None
    return datetime.fromtimestamp(int(ts)).astimezone().isoformat(timespec="seconds")


def now_iso():
    return datetime.now().astimezone().isoformat(timespec="seconds")


def parse_windows(raw, now_epoch):
    windows = []
    for item in raw.split(","):
        item = item.strip().lower()
        if not item:
            continue
        if item == "today":
            start = datetime.now().astimezone().replace(
                hour=0,
                minute=0,
                second=0,
                microsecond=0,
            )
            windows.append((item, int(start.timestamp())))
            continue
        if not item.endswith("d"):
            raise ValueError(f"unsupported window {item!r}; use today or Nd windows")
        days = int(item[:-1])
        if days <= 0:
            raise ValueError(f"window must be positive: {item!r}")
        windows.append((item, now_epoch - days * 86400))
    return windows


def decimal_to_float(value):
    return float(value.quantize(Decimal("0.000001")))


def connect_readonly(path):
    uri = f"file:{path}?mode=ro"
    return sqlite3.connect(uri, uri=True)


def table_exists(conn, name):
    row = conn.execute(
        "SELECT 1 FROM sqlite_master WHERE type='table' AND name=?",
        (name,),
    ).fetchone()
    return row is not None


def aggregate_window(conn, since_epoch):
    row = conn.execute(
        """
        SELECT
            COALESCE(SUM(input_tokens), 0),
            COALESCE(SUM(output_tokens), 0),
            COALESCE(SUM(cache_read_tokens), 0),
            COALESCE(SUM(cache_creation_tokens), 0),
            COALESCE(COUNT(*), 0),
            COALESCE(SUM(CAST(total_cost_usd AS REAL)), 0)
        FROM proxy_request_logs
        WHERE app_type = 'codex'
          AND created_at >= ?
        """,
        (since_epoch,),
    ).fetchone()

    input_tokens, output_tokens, cache_read_tokens, cache_creation_tokens, requests, total_cost = row
    input_tokens = int(input_tokens or 0)
    total_tokens = input_tokens + int(output_tokens or 0) + int(cache_creation_tokens or 0)
    hit_tokens = int(cache_read_tokens or 0)
    hit_rate = (hit_tokens / input_tokens) if input_tokens else 0.0

    return {
        "total_tokens": total_tokens,
        "hit_tokens": hit_tokens,
        "hit_rate": round(hit_rate, 6),
        "requests": int(requests or 0),
        "total_cost_usd": decimal_to_float(Decimal(str(total_cost or 0))),
    }


def get_last_event(conn):
    row = conn.execute(
        """
        SELECT MAX(created_at)
        FROM proxy_request_logs
        WHERE app_type = 'codex'
        """
    ).fetchone()
    return row[0] if row else None


def parse_event_timestamp(raw):
    if not raw:
        return 0
    try:
        return datetime.fromisoformat(raw.replace("Z", "+00:00")).timestamp()
    except Exception:
        return 0


def quota_unavailable():
    return {
        "remaining_percent": None,
        "used_percent": None,
        "reset_at": None,
        "available": False,
    }


def reset_credits_unavailable():
    return {
        "available": False,
        "available_count": None,
        "next_expires_at": None,
        "expires_at": [],
        "fetched_at": None,
        "checked_at": None,
        "stale": False,
    }


def write_app_server_message(process, message):
    if process.stdin is None:
        raise RuntimeError("Codex app-server stdin is unavailable")
    process.stdin.write((json.dumps(message, separators=(",", ":")) + "\n").encode("utf-8"))
    process.stdin.flush()


def read_app_server_rate_limits(codex_bin, timeout_seconds):
    resolved = shutil.which(codex_bin) if os.path.sep not in codex_bin else os.path.expanduser(codex_bin)
    if not resolved or not os.path.isfile(resolved):
        raise RuntimeError("Codex CLI was not found")

    process = subprocess.Popen(
        [resolved, "app-server", "--listen", "stdio://"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    deadline = time.monotonic() + timeout_seconds
    buffer = b""
    initialized = False
    try:
        write_app_server_message(
            process,
            {
                "method": "initialize",
                "id": 0,
                "params": {
                    "clientInfo": {
                        "name": "codex_usage_toolbar",
                        "title": "Codex Usage Toolbar",
                        "version": SCHEMA_VERSION,
                    }
                },
            },
        )

        while time.monotonic() < deadline:
            if process.stdout is None:
                raise RuntimeError("Codex app-server stdout is unavailable")
            remaining = max(0.0, deadline - time.monotonic())
            readable, _, _ = select.select([process.stdout], [], [], remaining)
            if not readable:
                break

            chunk = os.read(process.stdout.fileno(), 65536)
            if not chunk:
                break
            buffer += chunk

            while b"\n" in buffer:
                raw_line, buffer = buffer.split(b"\n", 1)
                if not raw_line.strip():
                    continue
                try:
                    message = json.loads(raw_line)
                except (UnicodeDecodeError, json.JSONDecodeError):
                    continue

                if message.get("id") == 0 and not initialized:
                    if "error" in message:
                        raise RuntimeError("Codex app-server initialization failed")
                    initialized = True
                    write_app_server_message(process, {"method": "initialized"})
                    write_app_server_message(process, {"method": "account/rateLimits/read", "id": 1})
                    continue

                if message.get("id") == 1:
                    if "error" in message:
                        raise RuntimeError("Codex app-server rate limit query failed")
                    result = message.get("result")
                    if not isinstance(result, dict):
                        raise RuntimeError("Codex app-server returned an invalid rate limit response")
                    return result

        raise RuntimeError("Codex app-server rate limit query timed out")
    finally:
        if process.stdin is not None:
            try:
                process.stdin.close()
            except OSError:
                pass
        if process.poll() is None:
            process.terminate()
            try:
                process.wait(timeout=0.5)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait(timeout=0.5)


def load_reset_credits_from_app_server(codex_bin, timeout_seconds):
    result = read_app_server_rate_limits(codex_bin, timeout_seconds)
    summary = result.get("rateLimitResetCredits")
    if not isinstance(summary, dict):
        return reset_credits_unavailable()

    available_count = summary.get("availableCount")
    if not isinstance(available_count, int) or isinstance(available_count, bool) or available_count < 0:
        return reset_credits_unavailable()

    expirations = []
    credits = summary.get("credits")
    if isinstance(credits, list):
        for credit in credits:
            if not isinstance(credit, dict) or credit.get("status") != "available":
                continue
            expires_at = credit.get("expiresAt")
            if isinstance(expires_at, int) and not isinstance(expires_at, bool):
                expirations.append(expires_at)

    expirations.sort()
    return {
        "available": True,
        "available_count": available_count,
        "next_expires_at": iso_from_epoch(expirations[0]) if expirations else None,
        "expires_at": [iso_from_epoch(item) for item in expirations],
        "fetched_at": now_iso(),
        "checked_at": now_iso(),
        "stale": False,
    }


def parse_reset_credits_cache(raw):
    if not isinstance(raw, dict):
        return None

    available = raw.get("available")
    available_count = raw.get("available_count")
    expirations = raw.get("expires_at")
    fetched_at = raw.get("fetched_at")
    checked_at = raw.get("checked_at")
    stale = raw.get("stale")
    if not isinstance(available, bool):
        return None
    if available_count is not None and (
        not isinstance(available_count, int)
        or isinstance(available_count, bool)
        or available_count < 0
    ):
        return None
    if not isinstance(expirations, list) or not all(
        isinstance(item, str) and parse_event_timestamp(item) > 0
        for item in expirations
    ):
        return None
    if not isinstance(fetched_at, str) or parse_event_timestamp(fetched_at) <= 0:
        return None
    if not isinstance(checked_at, str) or parse_event_timestamp(checked_at) <= 0:
        return None
    if not isinstance(stale, bool):
        return None

    next_expires_at = raw.get("next_expires_at")
    if next_expires_at is not None and (
        not isinstance(next_expires_at, str)
        or parse_event_timestamp(next_expires_at) <= 0
    ):
        return None

    return {
        "available": available,
        "available_count": available_count,
        "next_expires_at": next_expires_at,
        "expires_at": expirations,
        "fetched_at": fetched_at,
        "checked_at": checked_at,
        "stale": stale,
    }


def load_reset_credits_cache(cache_path):
    path = os.path.expanduser(cache_path)
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return parse_reset_credits_cache(json.load(handle))
    except (OSError, json.JSONDecodeError):
        return None


def save_reset_credits_cache(cache_path, reset_credits):
    path = os.path.expanduser(cache_path)
    directory = os.path.dirname(path)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    temp_path = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=directory,
            prefix="reset-credits-",
            suffix=".tmp",
            delete=False,
        ) as handle:
            temp_path = handle.name
            json.dump(reset_credits, handle, ensure_ascii=False, separators=(",", ":"))
            handle.write("\n")
        os.chmod(temp_path, 0o600)
        os.replace(temp_path, path)
    finally:
        if temp_path is not None and os.path.exists(temp_path):
            try:
                os.unlink(temp_path)
            except OSError:
                pass


def load_reset_credits(codex_bin, timeout_seconds, cache_path, ttl_seconds):
    cached = load_reset_credits_cache(cache_path)
    now_epoch = time.time()
    if cached is not None:
        cache_age = max(0.0, now_epoch - parse_event_timestamp(cached["checked_at"]))
        if cache_age < ttl_seconds:
            error = "RESET_CREDITS_STALE" if cached["stale"] else None
            return cached, error

    try:
        fresh = load_reset_credits_from_app_server(codex_bin, timeout_seconds)
        if fresh["fetched_at"] is None:
            fresh["fetched_at"] = now_iso()
        fresh["checked_at"] = fresh["fetched_at"]
        try:
            save_reset_credits_cache(cache_path, fresh)
        except OSError:
            pass
        return fresh, None
    except (OSError, RuntimeError, subprocess.SubprocessError):
        if cached is not None:
            cached["stale"] = True
            cached["checked_at"] = now_iso()
            try:
                save_reset_credits_cache(cache_path, cached)
            except OSError:
                pass
            return cached, "RESET_CREDITS_STALE"
        unavailable = reset_credits_unavailable()
        unavailable["checked_at"] = now_iso()
        unavailable["stale"] = True
        return unavailable, "RESET_CREDITS_UNAVAILABLE"


def quota_from_rate_limit(item):
    if not item:
        return quota_unavailable()

    used = item.get("used_percent")
    reset_at = item.get("resets_at")
    if used is None or reset_at is None:
        return quota_unavailable()

    used = float(used)
    return {
        "remaining_percent": round(max(0.0, min(100.0, 100.0 - used)), 3),
        "used_percent": round(max(0.0, min(100.0, used)), 3),
        "reset_at": iso_from_epoch(reset_at),
        "available": True,
    }


def load_quota_from_codex_sessions():
    latest_by_window = {}
    for path in glob.glob(os.path.expanduser(CODEX_SESSIONS_GLOB), recursive=True):
        try:
            with open(path, "r", encoding="utf-8") as handle:
                for line in handle:
                    try:
                        event = json.loads(line)
                    except json.JSONDecodeError:
                        continue

                    rate_limits = (event.get("payload") or {}).get("rate_limits")
                    if not isinstance(rate_limits, dict):
                        continue

                    event_time = parse_event_timestamp(event.get("timestamp"))
                    for key in ("primary", "secondary"):
                        item = rate_limits.get(key)
                        if not isinstance(item, dict):
                            continue

                        window = item.get("window_minutes")
                        if window not in (FIVE_HOUR_MINUTES, WEEKLY_MINUTES):
                            continue

                        previous = latest_by_window.get(window)
                        if previous is None or event_time >= previous[0]:
                            latest_by_window[window] = (event_time, item)
        except OSError:
            continue

    return {
        "five_hour": quota_from_rate_limit(latest_by_window.get(FIVE_HOUR_MINUTES, (None, None))[1]),
        "weekly": quota_from_rate_limit(latest_by_window.get(WEEKLY_MINUTES, (None, None))[1]),
    }


def export_codex(args):
    if args.codex_timeout_seconds <= 0:
        raise ValueError("--codex-timeout-seconds must be positive")
    if args.reset_credits_ttl_seconds <= 0:
        raise ValueError("--reset-credits-ttl-seconds must be positive")

    db_path = os.path.expanduser(args.db)
    if not os.path.exists(db_path):
        raise FileNotFoundError(f"cc-switch database not found: {db_path}")

    now_epoch = int(time.time())
    windows = parse_windows(args.windows, now_epoch)
    collected_at = now_iso()

    with connect_readonly(db_path) as conn:
        if not table_exists(conn, "proxy_request_logs"):
            raise RuntimeError("cc-switch database does not contain proxy_request_logs")

        tokens = {
            label: aggregate_window(conn, since_epoch)
            for label, since_epoch in windows
        }
        last_event = get_last_event(conn)

    quota = load_quota_from_codex_sessions()
    reset_credits, reset_credits_error = load_reset_credits(
        args.codex_bin,
        args.codex_timeout_seconds,
        args.reset_credits_cache,
        args.reset_credits_ttl_seconds,
    )

    errors = []
    if not quota["five_hour"]["available"] or not quota["weekly"]["available"]:
        errors.append(
            {
                "code": "QUOTA_PARTIAL",
                "message": "Some quota windows were not found in Codex session rate_limits.",
            }
        )
    if reset_credits_error == "RESET_CREDITS_STALE":
        errors.append(
            {
                "code": "RESET_CREDITS_STALE",
                "message": "Using cached Codex reset credit data after refresh failed.",
            }
        )
    elif not reset_credits["available"]:
        errors.append(
            {
                "code": "RESET_CREDITS_UNAVAILABLE",
                "message": "Codex reset credit data is unavailable.",
            }
        )

    return {
        "schema_version": SCHEMA_VERSION,
        "app": "codex",
        "source": "cc-switch-db-codex-session-and-app-server-exporter",
        "cc_switch": {
            "version": None,
        },
        "collected_at": collected_at,
        "quota": quota,
        "reset_credits": reset_credits,
        "tokens": tokens,
        "refresh": {
            "last_success_at": collected_at,
            "cc_switch_last_event_at": iso_from_epoch(last_event),
            "stale": False,
        },
        "errors": errors,
    }


def build_parser():
    parser = argparse.ArgumentParser(
        prog="ccswitch-export",
        description="Export a stable, sanitized JSON contract for Codex usage from cc-switch.",
    )
    parser.add_argument("app", choices=["codex"])
    parser.add_argument("--windows", default=",".join(DEFAULT_WINDOWS))
    parser.add_argument("--json", action="store_true", dest="as_json")
    parser.add_argument("--db", default="~/.cc-switch/cc-switch.db")
    parser.add_argument("--codex-bin", default=os.environ.get("CODEX_CLI_BIN", "codex"))
    parser.add_argument("--codex-timeout-seconds", type=float, default=3.0)
    parser.add_argument("--reset-credits-cache", default=RESET_CREDITS_CACHE)
    parser.add_argument("--reset-credits-ttl-seconds", type=float, default=RESET_CREDITS_TTL_SECONDS)
    return parser


def main(argv):
    parser = build_parser()
    args = parser.parse_args(argv)

    try:
        payload = export_codex(args)
    except Exception as exc:
        print(f"ccswitch-export: {exc}", file=sys.stderr)
        return 1

    if not args.as_json:
        parser.error("only --json output is currently supported")

    print(json.dumps(payload, ensure_ascii=False, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
